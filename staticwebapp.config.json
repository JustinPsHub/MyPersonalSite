{
  "routes": [
    {
      "route": "/admin",
      "rewrite": "/admin.html",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, noarchive, nosnippet"
      }
    },
    {
      "route": "/admin.html",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, noarchive, nosnippet"
      }
    },
    {
      "route": "/privacy",
      "rewrite": "/privacy.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/",
      "rewrite": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/visuals",
      "rewrite": "/visuals.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/platform",
      "rewrite": "/platform.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/resume",
      "rewrite": "/resume.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/contact",
      "rewrite": "/contact.html",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, noarchive, nosnippet"
      }
    },
    {
      "route": "/contact.html",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, noarchive, nosnippet"
      }
    },
    {
      "route": "/resume/*.docx",
      "headers": {
        "Cache-Control": "no-cache",
        "X-Robots-Tag": "noindex, noarchive"
      }
    },
    {
      "route": "/resume/*.pdf",
      "headers": {
        "Cache-Control": "no-cache",
        "X-Robots-Tag": "noindex, noarchive"
      }
    },
    {
      "route": "/*.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ],
  "trailingSlash": "never",
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' https://palmer-observatory.happy-mink-8142.chatgpt.site; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "X-Frame-Options": "DENY"
  },
  "mimeTypes": {
    ".woff": "font/woff",
    ".docx": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    ".pdf": "application/pdf"
  },
  "platform": {
    "apiRuntime": "node:22"
  }
}
